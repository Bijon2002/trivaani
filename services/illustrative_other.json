      "label": {
        "en": "Grama Niladhari Division",
        "si": "ග්‍රාම නිලධාරී වසම",
        "ta": "கிராம நிலதாரி பிரிவு"
      },
      "hint": {
        "en": "Name or number of GN division.",
        "si": "ග්‍රාම නිලධාරී වසමේ නම හෝ අංකය.",
        "ta": "கிராம அலுவலர் பிரிவின் பெயர் அல்லது எண்."
      }
    },
    {
      "id": "applicant_address",
      "type": "text",
      "required": true,
      "label": {
        "en": "Installation Address",
        "si": "සම්බන්ධතාවය අවශ්‍ය ලිපිනය",
        "ta": "இணைப்பு கோரப்படும் முகவரி"
      },
      "hint": {
        "en": "Premises where water meter will be installed.",
        "si": "ජල මීටරය සවි කිරීමට අවශ්‍ය ස්ථානයේ ලිපිනය.",
        "ta": "நீர்மானி பொருத்தப்பட வேண்டிய இடத்தின் முகவரி."
      }
    },
    {
      "id": "household_members_count",
      "type": "text",
