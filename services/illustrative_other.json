        "si": "ප්‍රධාන ගෘහමූලිකයාගේ නම.",
        "ta": "பிரதான குடும்பத் தலைவரின் பெயர்."
      }
    },
    {
      "id": "applicant_nic",
      "type": "text",
      "required": true,
      "label": {
        "en": "Applicant NIC Number",
        "si": "ඉල්ලුම්කරුගේ හැඳුනුම්පත් අංකය",
        "ta": "விண்ணப்பதாரரின் அடையாள அட்டை எண்"
      },
      "hint": {
        "en": "NIC number.",
        "si": "හැඳුනුම්පත් අංකය.",
        "ta": "அடையாள அட்டை எண்."
      }
    },
    {
      "id": "applicant_phone",
      "type": "tel",
      "required": true,
      "label": {
