{
  "service_id": "illustrative_water_connection",
  "is_illustrative": true,
  "title": {
    "en": "Community Water Connection Request (Illustrative)",
    "si": "ප්‍රජා ජල සැපයුම් අයදුම්පත (නිදර්ශනාත්මක)",
    "ta": "சமூக குடிநீர் இணைப்பு விண்ணப்பம் (விளக்கத்திற்குரியது)"
  },
  "department": {
    "en": "Department of Community Water Supply (Illustrative)",
    "si": "ප්‍රජා ජල සම්පාදන දෙපාර්තමේන්තුව (නිදර්ශනාත්මක)",
    "ta": "சமூக நீர் வழங்கல் திணைக்களம் (விளக்கத்திற்குரியது)"
  },
  "description": {
    "en": "Illustrative config demonstrating that Trivaani can onboard a new public service without any code changes.",
    "si": "කේත වෙනස් කිරීමකින් තොරව නව රාජ්‍ය සේවාවක් ත්‍රිවාණී පද්ධතියට එක් කළ හැකි බව පෙන්වන නිදර්ශනාත්මක වින්‍යාසය.",
    "ta": "எந்தவொரு குறியீட்டு மாற்றமும் இன்றி புதிய பொதுச் சேவையை திரிவாணி அமைப்பில் இணைக்க முடியும் என்பதை காட்டும் விளக்க மாதிரி."
  },
  "supported_languages": ["si", "ta", "en"],
  "required_documents": [
    {
      "doc_type": "applicant_nic",
      "mandatory": true,
      "title": {
        "en": "Applicant National Identity Card (NIC)",
        "si": "ඉල්ලුම්කරුගේ ජාතික හැඳුනුම්පත",
        "ta": "விண்ணப்பதாரரின் தேசிய அடையாள அட்டை"
      },
      "description": {
        "en": "Front photo of valid NIC.",
        "si": "වලංගු හැඳුනුම්පතේ ඉදිරිපස ඡායාරූපය.",
        "ta": "செல்லுபடியாகும் அடையாள அட்டையின் முன் புகைப்படம்."
      },
      "extractable_fields": [
        "applicant_nic",
        "applicant_name"
      ]
    },
    {
      "doc_type": "grama_niladhari_certificate",
      "mandatory": true,
      "title": {
        "en": "Grama Niladhari Residence Certificate",
        "si": "ග්‍රාම නිලධාරී පදිංචි සහතිකය",
        "ta": "கிராம நிலதாரி வதிவிடச் சான்றிதழ்"
      },
      "description": {
        "en": "Certificate proving residence in the division.",
        "si": "කොට්ඨාසයේ පදිංචිය තහවුරු කරන ග්‍රාම නිලධාරී සහතිකය.",
        "ta": "பிரிவில் வசிப்பதை உறுதிப்படுத்தும் கிராம அலுவலர் சான்றிதழ்."
      },
      "extractable_fields": [
        "grama_niladhari_division",
        "applicant_address"
      ]
    }
  ],
  "fields": [
    {
